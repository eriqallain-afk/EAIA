{
  "openapi": "3.1.0",
  "info": {
    "title": "EAIA GitHub — Read Only",
    "description": "Accès lecture à tous les repos produits EAIA + FACTORY. Lister et lire les agents, runbooks, index.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://api.github.com" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/repos/{owner}/{repo}/contents/{path}": {
      "get": {
        "operationId": "getFileContent",
        "summary": "Lire un fichier ou lister un répertoire dans n'importe quel repo EAIA",
        "description": "Retourne le contenu base64 d'un fichier (décodez avant usage) ou la liste des entrées d'un répertoire.",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "default": "eriqallain-afk" },
            "description": "Propriétaire GitHub des repos EAIA"
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "IT",
                "ARMY_DAM_DESIGN",
                "ARMY_NEA_WRITING",
                "ARMY_TRAD_INTEL",
                "IASM",
                "ADMK",
                "EDU_SERVICES",
                "FACTORY"
              ]
            },
            "description": "Repo produit ou FACTORY"
          },
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Chemin du fichier ou répertoire. Ex: 20_Agents/IT-SysAdmin/00_INSTRUCTIONS.md"
          },
          {
            "name": "ref",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "main" },
            "description": "Branche ou commit. Défaut: main"
          }
        ],
        "responses": {
          "200": {
            "description": "Fichier (objet) ou répertoire (tableau)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/FileContent" },
                    {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/DirEntry" }
                    }
                  ]
                }
              }
            }
          },
          "404": { "description": "Fichier ou repo introuvable" }
        }
      }
    },
    "/repos/{owner}/{repo}/contents/20_Agents": {
      "get": {
        "operationId": "listAgentsIT",
        "summary": "Lister les agents du repo IT (structure 20_Agents)",
        "parameters": [
          { "name": "owner", "in": "path", "required": true, "schema": { "type": "string", "default": "eriqallain-afk" } },
          { "name": "repo", "in": "path", "required": true, "schema": { "type": "string", "enum": ["IT"] } }
        ],
        "responses": {
          "200": {
            "description": "Liste des agents",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/DirEntry" } }
              }
            }
          }
        }
      }
    },
    "/repos/{owner}/{repo}/contents/20_AGENTS": {
      "get": {
        "operationId": "listAgentsProduct",
        "summary": "Lister les agents d'un repo produit (structure 20_AGENTS)",
        "parameters": [
          { "name": "owner", "in": "path", "required": true, "schema": { "type": "string", "default": "eriqallain-afk" } },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["ARMY_DAM_DESIGN", "ARMY_NEA_WRITING", "ARMY_TRAD_INTEL", "IASM", "ADMK", "FACTORY"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des agents",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/DirEntry" } }
              }
            }
          }
        }
      }
    },
    "/repos/{owner}/EDU_SERVICES/contents/20_SECTORS/{sector}/20_AGENTS": {
      "get": {
        "operationId": "listAgentsEDUSector",
        "summary": "Lister les agents d'un secteur EDU_SERVICES",
        "parameters": [
          { "name": "owner", "in": "path", "required": true, "schema": { "type": "string", "default": "eriqallain-afk" } },
          {
            "name": "sector",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Ex: CORRECTION_TRAVAUX"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des agents du secteur",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/DirEntry" } }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FileContent": {
        "type": "object",
        "properties": {
          "name":     { "type": "string" },
          "path":     { "type": "string" },
          "sha":      { "type": "string" },
          "size":     { "type": "integer" },
          "type":     { "type": "string", "enum": ["file", "dir", "symlink"] },
          "content":  { "type": "string", "description": "Contenu encodé base64 — décoder avant usage" },
          "encoding": { "type": "string", "enum": ["base64"] },
          "url":      { "type": "string" },
          "html_url": { "type": "string" }
        }
      },
      "DirEntry": {
        "type": "object",
        "properties": {
          "name":     { "type": "string" },
          "path":     { "type": "string" },
          "sha":      { "type": "string" },
          "size":     { "type": "integer" },
          "type":     { "type": "string", "enum": ["file", "dir"] },
          "url":      { "type": "string" },
          "html_url": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token GitHub Read-Only avec accès à tous les repos EAIA"
      }
    }
  }
}
